                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 Indian-Students-Card">
                        <img src="~/assets/images/indian-universities/cards-images/global opportunities for students.jpg" class="card-img-top" alt="British Council Great Scholarships for Indian Students" />
						<div class="card-body">
                            <h5 class="card-title">Global Opportunities for Students</h5>
