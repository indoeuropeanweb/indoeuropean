
@{
    ViewData["Title"] = "Partnership Opportunities for Indian Universities";
    ViewData["Description"] = "Partner with Indo-European to offer your students international education opportunities, enhance your global reputation, and access a worldwide network.";
    ViewData["Keywords"] = "Indian universities, university partnership, international education, global reputation, student mobility";
}

<style type="text/css">


    .box-forstudents {
        padding: 10px;
    }

    .bd-line {
        border: 1px solid #eee;
    }

    .box-forstudents img {
        border-radius: 10px;
        box-shadow: 3px 4px 16px #dfdfdf;
    }


        .box-forstudents img:hover {
            border-radius: 10px;
            box-shadow: 3px 4px 16px #dfdfdf;
        }


    .box-forstudents h4 {
        padding: 15px 0px 0px;
    }



    .box-fs {
        padding: 10px 5px;
    }

        .box-fs h3 {
            font-size: 28px;
            font-weight: 600;
            padding-bottom: 5px;
        }

        .box-fs p {
            font-size: 16px;
        }



    .heading {
        font-weight: 500;
        margin: 40px 0px;
    }

    .demo-problem, .demo-solution {
        margin: -20px 0px;
    }

        .demo-problem, .demo-solution img {
            width: 25px;
            padding: 0px !important;
            margin: 0px 5px !important;
        }

        .demo-problem, .demo-solution p {
            line-height: 20px;
        }

    .demo-solution--flexbox {
        display: flex;
        align-items: center;
        margin: auto;
    }
</style>

<section class="breadcrumb-indian-back">
    <div class="our-services-breadcrumb">
        <div class="container">
            <ul class="edu-breadcrumb-services">
                <li class="breadcrumb-item"><a asp-controller="home" asp-action="index">Home</a></li>
                <li class="separator"><i class="icon-angle-right"></i></li>
                <li class="breadcrumb-item" aria-current="page">Indian Universities</li>
            </ul>
            <div class="breadcrumb-inner">
                <div class="services-title">
                    <h1 class="title">
                        Indian Universities
                    </h1>
                    <h2>
                        Indian Universities Partnership with Indo European
                    </h2>
                    <p>We are your trusted partner in facilitating international education opportunities for your students. With over 20 years of experience in the field, we specialize in guiding students towards prestigious universities worldwide, offering a diverse range of courses across various disciplines.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container">
    <div style="margin: 50px 0">
        <div class="col-lg-12 section-title">
