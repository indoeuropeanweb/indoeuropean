						<div class="card-body">
                            <h5 class="card-title">Exclusive International Collaborations</h5>
                            <p>Partnering with Indo European opens doors to collaborations with renowned overseas universities, giving Indian institutions a competitive edge.</p>
                        </div>
                    </div>
                </div>

                <!-- Ontario Trillium Scholarship -->
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 Indian-Students-Card">
