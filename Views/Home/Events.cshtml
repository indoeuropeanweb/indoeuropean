@{
    ViewData["Title"] = "Study Abroad Events & Workshops | Indo-European";
    ViewData["Description"] = "Attend our study abroad events to meet university representatives, get personalised guidance, and learn about scholarships for your dream destination.";
    ViewData["Keywords"] = "study abroad events, university fair, education workshops, Indo-European events, international education";
}

<section class="breadcrumb-events-back">
    <div class="our-services-breadcrumb">
        <div class="container">
            <ul class="edu-breadcrumb-services">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="separator"><i class="icon-angle-right"></i></li>
                <li class="breadcrumb-item" aria-current="page">Events</li>
            </ul>
            <div class="breadcrumb-inner">
                <div class="services-title">
                    <h1 class="title">EXPLORE EXCLUSIVE EVENTS OF STUDY ABROAD</h1>
                    <h2>
                        Be a part of online and in-person events
                    </h2>
                    <p>All the events related to study abroad conducted by Indo European are here. Engage with university representatives and experts to delve into your academic opportunities, campus experiences, and more through discussions.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<section>
    <div class="container">
        <div class="events-container">
        <div class="row mb-5">
            <div class="event-heading">
            <h3>Ready to Go Abroad? Join Top Study Abroad Events of Indo European!</h3>
                <span class="shape-line"><i class="icon-19"></i></span>
                </div>
            <div class="col-md-6">
                <div class="input-group mb-3">
                    <div class="input-group-prepend search-event">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" class="form-control search-input" placeholder="Search Events"u aria-describedby="basic-addon1" id="search-event">
                </div>
            </div>
            <div class="col-md-6 row">
                <div class="col-md-6">
                    <select class="form-select event-select" aria-label="Event Type" id="event-type-selection">
                        <option value="" selected>Event Type</option>
                            <option value="inperson">In Person Only</option>
                            <option value="online">Online Only</option>
                            <option value="both">In-Person &amp; Online</option>
                    </select>
                </div>
                <div class="col-md-6">
                        <select class="form-select event-select" aria-label="Location" id="event-location-selection">
                        <option value="" selected>Location</option>
                        <option value="new-delhi">New Delhi (Head Office)</option>
                        <option value="amritsar">Amritsar</option>
                        <option value="bathinda">Bathinda</option>
                        <option value="chandigarh">Chandigarh</option>
                        <option value="jalandhar">Jalandhar</option>
                        <option value="ludhiana">Ludhiana</option>
                        <option value="patiala">Patiala</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="events-grid" id="Events-Container">
        <div class="event-features-container">
            <div class="event-heading">
            <h3>Why You Should Attend Our Events</h3>
                <span class="shape-line"><i class="icon-19"></i></span>
                </div>
                <div class="row event-features">
                    <div class="card mb-3 event-card" style="max-width: 540px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="~/assets/images/events/16341.jpg" class="img-fluid rounded-start" alt="Connect with University Representatives">
							</div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">Connect with University Representatives  </h5>
                                    <p class="card-text">
                                        Connect Directly with University Representatives
                                        Take your study abroad journey to the next level! Get first-hand, exclusive insights straight from the source by interacting with official university representatives from top global institutions.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3 event-card" style="max-width: 540px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="~/assets/images/events/2.jpg" class="img-fluid rounded-start" alt="Discover Universities and Courses">
							</div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">Discover Universities and Courses</h5>
                                    <p class="card-text">Explore a wide range of top-ranked universities and in-demand courses tailored to match your academic interests and long-term career goals. Whether you're aiming for a specialized degree or a globally recognized qualification, we help you find the perfect fit.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3 event-card" style="max-width: 540px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="~/assets/images/events/3.jpg" class="img-fluid rounded-start" alt="Get Personalised Guidance">
							</div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">Get Personalised Guidance</h5>
                                    <p class="card-text">Receive dedicated, one-on-one support from our team of expert counsellors who are here to guide you at every step of your journey. From identifying the right course and university to navigating the application and visa process, we offer tailored advice based on your goals, interests, and academic background.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card mb-3 event-card" style="max-width: 540px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="~/assets/images/events/4.jpg" class="img-fluid rounded-start" alt="Scholarships and Financial Aid">
							</div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">Scholarships and Financial Aid</h5>
                                    <p class="card-text">Don’t let finances hold you back from achieving your international education goals. Explore a wide range of scholarships, grants, and financial aid options offered by universities, governments, and private organizations to help you manage the cost of studying abroad.</p>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
        </div>
    </div>
    </div>
</section>


