@{
    ViewData["Title"] = "Events";
    ViewData["Description"] = "Discover Indo-European, a leading global education consultancy with 20+ years of expertise connecting Indian students to top international universities worldwide.";
}

<section class="breadcrumb-events-back">
    <div class="our-services-breadcrumb">
        <div class="container">
            <ul class="edu-breadcrumb-services">
                <li class="breadcrumb-item"><a asp-controller="home" asp-action="index">Home</a></li>
                <li class="separator"><i class="icon-angle-right"></i></li>
                <li class="breadcrumb-item" aria-current="page">Events</li>
            </ul>
            <div class="breadcrumb-inner">
                <div class="services-title">
                    <h1 class="title">STUDY IN EUROPE VIRTUAL EVENT</h1>
                    <h2>
                        Exclusive event for students planning to study abroad
                    </h2>
                    <p>Join the Study in Europe Virtual Event to explore affordable study options, learn about visa opportunities, and get complete guidance from an expert. It offers benefits like studying without IELTS, spouse visa availability, and more.</p>
                </div>
            </div>
        </div>
    </div>
