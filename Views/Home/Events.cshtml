@{
    ViewData["Title"] = "Study Abroad Events & Workshops | International Education Seminars";
    ViewData["Description"] = "Join top study abroad events by Indo European. Meet university representatives, explore global academic opportunities, and attend 'Study in Europe' days in New Delhi, Chandigarh, and across Punjab.";
    ViewData["Keywords"] = "study abroad events, education fair India, study in Europe seminars, international university workshops, overseas education events Delhi, study abroad webinars, university representative meetups, Indo European events.";
    ViewData["OgTitle"] = "Upcoming Study Abroad Events | Join Indo European";
    ViewData["OgDescription"] = "Engage with university experts at our online and in-person events. Secure your future with our 'Study in Europe' days and global education workshops.";
    ViewData["OgImage"] = "https://indoeuropean.in/assets/images/logo/logo-dark.webp";
    ViewData["OgUrl"] = "https://indoeuropean.in/events";
}

<section class="breadcrumb-events-back">
    <div class="our-services-breadcrumb">
        <div class="container">
            <ul class="edu-breadcrumb-services">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="separator"><i class="icon-angle-right"></i></li>
                <li class="breadcrumb-item" aria-current="page">Events</li>
            </ul>
            <div class="breadcrumb-inner">
                <div class="services-title">
                    <h1 class="title">Engage with Experts in our Events</h1>
                    <h2>
                        Be a part of online and in-person events
                    </h2>
                    <p>All the events and workshops related to study abroad conducted by Indo European are here. Engage with university representatives and experts to delve into your academic opportunities, campus experiences, and more through discussions.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<section>
    <div class="container">
        <div class="events-container">
        <div class="row mb-5">
            <div class="event-heading">
            <h3>Ready to Go Abroad? Join Top Study Abroad Events of Indo European!</h3>
                <span class="shape-line"><i class="icon-19"></i></span>
                </div>
            <div class="col-md-6">
                <div class="input-group mb-3">
                    <div class="input-group-prepend search-event">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" class="form-control search-input" placeholder="Search Events" uaria-describedby="basic-addon1" id="search-event">
                </div>
            </div>
            <div class="col-md-6 row">
                <div class="col-md-6">
                    <select class="form-select event-select" aria-label="Event Type" id="event-type-selection">
                        <option value="" selected>Event Type</option>
                            <option value="inperson">In Person Only</option>
                            <option value="online">Online Only</option>
                            <option value="both">In-Person &amp; Online</option>
                    </select>
                </div>
                <div class="col-md-6">
                        <select class="form-select event-select" aria-label="Location" id="event-location-selection">
                        <option value="" selected>Location</option>
                        <option value="new-delhi">New Delhi (Head Office)</option>
                        <option value="amritsar">Amritsar</option>
                        <option value="bathinda">Bathinda</option>
                        <option value="chandigarh">Chandigarh</option>
                        <option value="jalandhar">Jalandhar</option>
                        <option value="ludhiana">Ludhiana</option>
                        <option value="patiala">Patiala</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="events-grid" id="Events-Container">
            <div class="loader-container">
		     <img style="max-width: 100px;" src="~/assets/images/icons/preloader.gif" alt="Indo-Loader"/>
            </div>
        </div>
    </div>
    </div>
</section>

<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ItemList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "item": {
            "@@type": "EducationEvent",
            "name": "Study in Europe Day",
            "description": "Engage with university representatives and experts to delve into academic opportunities in Europe.",
            "organizer": {
              "@@type": "Organization",
              "name": "Indo European",
              "url": "https://indoeuropean.in/"
            },
            "location": {
              "@@type": "Place",
              "name": "Multiple Locations (Delhi, Chandigarh, Punjab)",
              "address": {
                "@@type": "PostalAddress",
                "addressCountry": "IN"
              }
            },
            "eventStatus": "https://schema.org/EventScheduled",
            "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode"
          }
        }
      ]
    }
</script>