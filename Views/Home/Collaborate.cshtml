<style type="text/css">


    .box-forstudents {
        padding: 10px;
    }

    .bd-line {
        border: 1px solid #eee;
    }

    .box-forstudents img {
        border-radius: 10px;
        box-shadow: 3px 4px 16px #dfdfdf;
    }


        .box-forstudents img:hover {
            border-radius: 10px;
            box-shadow: 3px 4px 16px #dfdfdf;
        }


    .box-forstudents h4 {
        padding: 15px 0px 0px;
    }



    .box-fs {
        padding: 10px 5px;
    }

        .box-fs h4 {
            font-size: 22px;
            font-weight: 600;
            padding-bottom: 5px;
            text-align: center;
        }

        .box-fs p {
            font-size: 16px;
        }



    .heading {
        font-weight: 500;
        margin: 40px 0px;
    }

    .demo-problem, .demo-solution {
        margin: -20px 0px;
    }

        .demo-problem, .demo-solution img {
            width: 25px;
            padding: 0px !important;
            margin: 0px 5px !important;
        }

        .demo-problem, .demo-solution p {
            line-height: 20px;
        }

    .demo-solution--flexbox {
        display: flex;
        align-items: center;
        margin: auto;
    }
    
</style>

