                    <img src="~/assets/images/university-selection/zealand.png" class="image-fluid" alt="New Zealand flag" />
                    <div class="content-overlay">
                        <h5 class="text-white">New Zealand</h5>
                    </div>
                </div>
                </a>
            </div>
        </div>
        <div class="row text-center g-4">
            <!-- Card 1 -->
            <div class="col-sm-6 col-md-6 col-lg-3">
                <a asp-controller="destinations" asp-action="singapore"><div class="accommodation-card">
                    @* <div class="location-badge">Rome</div> *@
                    <img src="~/assets/images/university-selection/singapore.png" class="image-fluid" alt="Singapore-flag" />
                    <div class="content-overlay">
                        <h5 class="text-white">Singapore</h5>
                    </div>
                </div>
                </a>
            </div>

            <!-- Card 2 -->
            <div class="col-sm-6 col-md-6 col-lg-3">
                <a asp-controller="destinations" asp-action="uk"><div class="accommodation-card">
                    @* <div class="location-badge">Valencia</div> *@
                    <img src="~/assets/images/university-selection/uk.png" class="image-fluid" alt="UK flag" />
                    <div class="content-overlay">
                        <h5 class="text-white">UK</h5>
                    </div>
                </div>
                </a>
            </div>

            <!-- Card 3 -->
            <div class="col-sm-6 col-md-6 col-lg-3">
                <a asp-controller="destinations" asp-action="usa"><div class="accommodation-card">
                    @* <div class="location-badge">Frankfurt</div> *@
                    <img src="~/assets/images/university-selection/usa.png" class="image-fluid" alt="USA-flag" />
                    <div class="content-overlay">
                        <h5 class="text-white">USA</h5>
                    </div>
                </div>
                </a>
            </div>

            <!-- Card 4 -->
            <div class="col-sm-6 col-md-6 col-lg-3">
                <a asp-controller="destinations" asp-action="ireland"><div class="accommodation-card">
                    @* <div class="location-badge">Glasgow</div> *@
                    <img src="~/assets/images/university-selection/ireland.png" class="image-fluid" alt="Ireland-flag" />
                    <div class="content-overlay">
                        <h5 class="text-white">Ireland</h5>
                    </div>
                </div>
                </a>
            </div>
        </div>
    </div>
</section>




<section class="container mt-5 pt-5">
    <div class="row mt-3">
        <div class="col-lg-12 section-title">
            <div class="testimonial-heading">
                <h2 class="title">How to Choose the Right Course?</h2>
            </div>
            <span class="shape-line"><i class="icon-19"></i></span>
        </div>
        <div class="mt-3">
            <h4>Identify Your Interests and Goals</h4>
            <p class="mt-3">Start by understanding your passions and long-term career aspirations. Choose a course that excites you and aligns with your professional objectives.</p>
        </div>
        <div class="mt-3">
            <h4>Research Universities and Programs</h4>
            <p class="mt-3">Look for universities that are renowned for your chosen field of study. Consider factors like global rankings, faculty expertise, and program structure.</p>
        </div>
        <div class="mt-3">
            <h4>Consider Future Opportunities</h4>
            <p class="mt-3">
                Evaluate the career prospects and industry demand for your chosen course. Opt for programs that offer internships, research opportunities, and strong industry connections.
            </p>
        </div>
        <div class="mt-3">
            <h4>Check Entry Requirements</h4>
            <p class="mt-3">
                Ensure you meet the academic and language requirements for the course. If needed, seek guidance on preparing for entrance exams or language proficiency tests.
            </p>
        </div>
        <div class="mt-3">
            <h4>Seek Expert Guidance</h4>
            <p class="mt-3">
                Our experienced counselors can help you navigate the overwhelming options, shortlist the best courses, and guide you through the application process.
            </p>
        </div>
    </div>
</section>




