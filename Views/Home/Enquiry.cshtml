@{
    ViewData["Title"] = "Enquiry | Indo European";
    ViewData["Description"] = "Contact Indo European for free expert counseling on study abroad programs, universities, visas & courses. Start your journey!";
    ViewData["Keywords"] = "study abroad enquiry, free counseling India, contact study abroad consultant, university advice, visa consultation, course guidance";
}

<div class="modern-schooling-cta-wrapper edu-cta-banner-area-6 bg-image mt-5" style="background:#f4f8ff;">
    <div class="services-subtitle" style="margin-top:120px; padding:40px;">
        <div class="enquiry-title">
            <h1 class="title">Reach Out for More Information</h1>
            <span class="shape-line"><i class="icon-19"></i></span>
        </div>
        <p>Whether you're looking for expert guidance, course information, visa support, or career opportunities abroad, we're here to help. <br />Fill out the enquiry form below and our team will get back to you within 24–48 hours. At Indo European, your global education journey starts with the right advice. </p>
    </div>
    <div class="container">
        <div class="col-md-12">
            <div class="contact-form enquiry_form">
                <form class="rnt-contact-form rwt-dynamic-form" action="#">
                    <h2>Connect with Us</h2>
                    <h3>(Free Counselling)</h3>
                    <div class="row row--10">
                        <div class="form-group col-lg-6">
                            <input type="text" name="contact-name" id="txtFName" placeholder="Your Name">
                        </div>
                        <div class="form-group col-lg-6">
                            <input type="email" name="contact-email" id="txtEmail" placeholder="Your Email">
                        </div>
                        <div class="form-group col-12">
                            <div class="select-box">
                                <div class="selected-option">
                                    <div>
                                        <svg xmlns="https://www.w3.org/2000/svg" aria-hidden="true" role="img" width="1.34em" height="1em" viewBox="0 0 640 480" data-icon="flag:in-4x3" class="iconify iconify--flag"><path fill="#f93" d="M0 0h640v160H0z"></path><path fill="#fff" d="M0 160h640v160H0z"></path><path fill="#128807" d="M0 320h640v160H0z"></path><g transform="matrix(3.2 0 0 3.2 320 240)"><circle r="20" fill="#008"></circle><circle r="17.5" fill="#fff"></circle><circle r="3.5" fill="#008"></circle><g id="IconifyId19135992cc35340290"><g id="IconifyId19135992cc35msf933ls340291"><g id="IconifyId19135992cc35340mnbasg3246292"><g id="IconifyId1935992cc3534093" fill="#008"><circle r=".9" transform="rotate(7.5 -8.8 133.5)"></circle><path d="M0 17.5L.6 7L0 2l-.6 5z"></path></g><use width="100%" height="100%" href="#IconifyId19135992cc3534085593" transform="rotate(15)"></use></g><use width="100%" height="100%" href="#IconifyId19135992cc35340mnba4292" transform="rotate(30)"></use></g><use width="100%" height="100%" href="#IconifyId19135992cc353402mabs3291" transform="rotate(60)"></use></g><use width="100%" height="100%" href="#IconifyId19135992cc35340290" transform="rotate(120)"></use><use width="100%" height="100%" href="#IconifyId19135992cc35340290" transform="rotate(-120)"></use></g></svg>
                                    </div>
                                    <input type="tel" name="txtPhone" id="txtPhone" placeholder="+91">
                                </div>
                                <div class="options">
                                    <select id="ddlCountryCodeid" name="ddlCountryCode" class="form-control form-list">
                                    </select>

                                </div>
                            </div>
                        </div>
                        <div class="form-group col-12">
                            <select name="HighestQualifcation" id="ddlHighestQualifcation">
                            </select>
                        </div>

                        <div class="form-group col-12">
                            <select name="ddlCourseCodeId" id="ddlCourseCodeId" required="">
                            </select>
                        </div>


                        <div class="form-group col-12">
                            <input type="text" name="txtCity" id="txtCity" placeholder="City" required="">
                        </div>

                        <div class="form-group col-12">
                            <select name="Programm" required="" id="ddlDestinationCodeid">
                            </select>
                        </div>

                        <div class="form-group col-12">
                            <select name="PreferredCallBackTime" required="" id="ddlPreferredCallBackTime">
                            </select>
                        </div>


                        <div class="form-group col-12 text-center">
                             <input type="button" value="Submit" class="rn-btn edu-btn submit-btn" onclick="formValidation();" /> 
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/assets/js/config.js"></script>
<script src="~/assets/js/landingpage.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>


