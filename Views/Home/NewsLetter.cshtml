

<style type="text/css">
    .newsletter-table {
        width: 80%;
        border-collapse: collapse;
        margin: 20px auto;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .newsletter-cell-3 {
        width: 210px;
    }

    .newsletter-header {
        background-color: #150958;
        color: white;
        padding: 12px;
        text-align: center;
        font-size: 1.25rem;
        font-weight: bold;
    }

    .newsletter-cell {
        padding: 12px;
        text-align: center;
        border: 1px solid #ddd;
        word-wrap: break-word;
    }

    .newsletter-row:nth-child(even) {
        background-color: #f4f4f4;
    }

    .newsletter-row:hover {
        background-color: #e2e2e2;
    }

    @@media screen and (max-width: 768px) {
        .newsletter-table {
            width: 100%;
            box-shadow: none;
        }

            .newsletter-table thead {
                display: none;
            }

            .newsletter-table,
            .newsletter-table tbody,
            .newsletter-table tr,
            .newsletter-table td {
                display: block;
                width: 100%;
            }

        .newsletter-row {
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fff;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
            padding: 10px;
        }

        .newsletter-cell {
            text-align: left; /* Change alignment for better readability */
            padding: 8px 16px;
            position: relative;
            border: none;
            border-bottom: 1px solid #eee;
            white-space: normal;
            word-break: break-word;
        }

            .newsletter-cell::before {
                content: attr(data-label);
                display: block;
                font-weight: bold;
                color: #150958;
                margin-bottom: 4px;
            }

        .newsletter-row .newsletter-cell:last-child {
            border-bottom: none;
        }
    }

    @@media screen and (max-width: 480px) {
        .newsletter-cell {
            padding: 10px;
        }
    }

    .register-number {
        max-width: 90%;
    }

        .register-number h4 {
            font-size: 18px;
            text-align: end;
        }


    .newsletter-btn {
          color: #150958;
          border: 1px solid #150958;
          padding: 8px 16px;
          margin: 5px 8px;
          border-radius: 25px;
        }

</style>


