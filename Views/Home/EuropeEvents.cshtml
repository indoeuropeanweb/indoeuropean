@{
    ViewData["Title"] = "Seminars, Webinars & Education Fairs | Indo European";
    ViewData["Description"] = "Stay updated with Indo European’s latest study abroad events, webinars, and university fairs. Meet global experts, explore top universities, and get personalized guidance for your international education journey.";
    ViewData["Keywords"] = "study abroad consultants, events, global education consultancy, seminars, webinars, education fairs for indian students, study in europe";
}

<style type="text/css">
    .event-table {
        width: 80%;
        border-collapse: collapse;
        margin: 20px auto;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .event-cell-3 {
        width: 210px;
    }

    .event-header {
        background-color: #150958;
        color: white;
        padding: 12px;
        text-align: center;
        font-size: 1.25rem;
        font-weight: bold;
    }

    .event-cell {
        padding: 12px;
        text-align: center;
        border: 1px solid #ddd;
        word-wrap: break-word;
    }

    .event-row:nth-child(even) {
        background-color: #f4f4f4;
    }

    .event-row:hover {
        background-color: #e2e2e2;
    }

    @@media screen and (max-width: 768px) {
      .event-table{
        width: 100%;
        box-shadow: none;
    }

    .event-table thead {
        display: none;
    }

    .event-table,
    .event-table tbody,
    .event-table tr,
    .event-table td {
        display: block;
        width: 100%;
    }

    .event-row {
        margin-bottom: 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        padding: 10px;
    }

    .event-cell {
        text-align: left; 
        padding: 8px 16px;
        position: relative;
        border: none;
        border-bottom: 1px solid #eee;
        white-space: normal;
        word-break: break-word;
    }

        .event-cell::before {
            content: attr(data-label);
            display: block;
            font-weight: bold;
            color: #150958;
            margin-bottom: 4px;
        }

    .event-row .event-cell:last-child {
        border-bottom: none;
    }

    }

    @@media screen and (max-width: 480px) {
    .event-cell{
        padding: 10px;
    }
    }

    .register-number{
	 max-width: 90%;
    }

    .register-number h4{
        font-size: 18px;
        text-align: end;
    }

</style>

